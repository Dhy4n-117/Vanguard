# ========================
# Vanguard Sentinel .gitignore
# ========================

# ----- Environment & Secrets -----
.env
.env.local
.env.production
*.pem
*.key

# ----- Python (Backend) -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
venv/
.venv/
env/
.Python
pip-log.txt

# ----- ChromaDB Local Storage -----
backend/chroma_db/

# ----- Node.js (Frontend) -----
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/

# ----- Docker Volumes (Local Data) -----
data/neo4j_data/
data/neo4j_logs/

# ----- IDE & OS -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ----- Logs -----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Testing & Coverage -----
.coverage
htmlcov/
.pytest_cache/
.nyc_output/
coverage/

# ----- Misc -----
*.bak
*.tmp
.cache/
