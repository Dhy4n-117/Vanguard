# ========================
# Vanguard Sentinel — Environment Variables
# ========================
# Copy this file to .env and fill in your values.

# ----- Neo4j -----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vanguard_sentinel_2024

# ----- ChromaDB -----
CHROMA_PERSIST_DIR=./backend/chroma_db

# ----- LLM Provider -----
# "ollama" = Fully local, zero-trust, air-gapped (default, recommended)
# "gemini" = Cloud fallback (requires GEMINI_API_KEY below)
LLM_PROVIDER=ollama

# ----- Ollama (Local AI — default) -----
# Install: https://ollama.com
# Pull a model: ollama pull llama3
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# ----- Google Gemini (optional cloud fallback) -----
# Only needed if LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_key_here

# ----- FastAPI -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ----- Frontend -----
NEXT_PUBLIC_API_URL=http://localhost:8000
