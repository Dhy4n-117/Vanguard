# ========================
# Vanguard Sentinel — Environment Variables
# ========================
# Copy this file to .env and fill in your values.

# ----- Neo4j -----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vanguard_sentinel_2024

# ----- ChromaDB -----
CHROMA_PERSIST_DIR=./backend/chroma_db

# ----- Google Gemini (Free Tier) -----
GEMINI_API_KEY=your_gemini_api_key_here

# ----- LLM Provider -----
# "gemini" = Cloud (requires API key above)
# "ollama" = Local, zero-trust (requires Ollama installed: https://ollama.com)
LLM_PROVIDER=gemini

# ----- Ollama (Local AI) -----
# Only used when LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# ----- FastAPI -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ----- Frontend -----
NEXT_PUBLIC_API_URL=http://localhost:8000
